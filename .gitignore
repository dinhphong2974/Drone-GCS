# ═══════════════════════════════════════════════
# DroneGCS — .gitignore
# ═══════════════════════════════════════════════

# ── Python bytecode & cache ──
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Virtual environments ──
venv/
.venv/
env/

# ── IDE / Editor ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS junk ──
Thumbs.db
.DS_Store
desktop.ini

# ── Build / Distribution ──
build/
dist/
*.egg-info/
*.egg

# ── Pytest cache ──
.pytest_cache/
htmlcov/
.coverage

# ── Logs ──
*.log

# ── AI internal docs (implementation plans, agent notes) ──
# Giữ memories.md và AGENT.md vì cần cho context
# Nhưng bỏ qua các file plan tạm
.ai/

# ── Temporary diff/patch files ──
*.patch
differences.patch
